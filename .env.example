# Copy to .env and fill in. Never commit .env.
# All keys below have free tiers. The app never charges users.

# Gemma 4 via the Gemini API (one call per check). https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it

# Groq: gpt-oss report + chat, Whisper speech-to-text. https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
GROQ_STT_MODEL=whisper-large-v3-turbo

# Optional: raises GitHub search limit from 10 to 30 per minute. No scopes needed.
# https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=

# Optional
# HF_TOKEN=
# EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# FORCE_IPV4=1
# PORT=8000
# HOST=127.0.0.1             # use 0.0.0.0 inside a container
# TRUST_PROXY=0              # set 1 behind a reverse proxy so rate limits use the real client IP
# MAX_PARALLEL_CHECKS=2      # checks that run at once
# MAX_WAITING_CHECKS=20      # running + queued checks before the server answers "busy"
# GEMMA_TIMEOUT_MS=20000     # per Gemma call; on timeout the planner falls back to gpt-oss
# LIMIT_CHECKS=8             # per IP per 10 min (rejected inputs don't count)
